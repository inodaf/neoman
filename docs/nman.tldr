:"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"General"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman inodaf/neoman # open TUI with doc list, full-text search, navigation"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman n26/* # install all docs from an org/user (must have read rights if private)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman . # open TUI with docs for the current directory (same behavior as org/user)"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Querying (enabling Agentic Engineering (Context))"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman query n26/repo \"api integration\" # return possible matches of each doc file (similarity)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman list n26/repo # list all doc files available for a specific project"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman view n26/repo <path/to/.md> # print the content of the doc file (raw)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman list # list available/installed documentations"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman query \"salesforce internal api\" # return possible matches for all projects and each doc file (similarity)"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Coding Agents"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman tokens n26/repo # n of tokens for the entire docs of a project"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman tokens n26/repo \"<path/to/.md> # n of tokens for a specific doc page of a project"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman skills # generate Skills for interacting efficiently with this tool"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman chat inodaf/neoman # open TUI with LLM Chat (talk with the docs)"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Maintainance"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman -status # disk-usage; last updated docs; current progress on syncs/downloads;"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman -sync # skip CRON and force refetch immediately"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman -prune # remove all docs installed"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman -clean # if a repo gets removed from remote, or doc has not been read for 1 month, clean it locally"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"- $ nman -config # opens the config file in EDITOR"}]},{"type":"paragraph","attrs":{"dir":"auto"}}]}},"parentId":"page:page","index":"b00AhT","typeName":"shape"},{"x":1443.9392176130557,"y":978.707503241295,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:sJuCta46QBC8tZ6LjCIbh","type":"geo","props":{"w":149,"h":158.30384569726448,"geo":"diamond","color":"black","labelColor":"black","fill":"none","dash":"draw","size":"m","font":"draw","align":"middle","verticalAlign":"middle","growY":0,"url":"","scale":1,"richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"docs in registry?"}]}]}},"parentId":"page:page","index":"aB2IX","typeName":"shape"},{"x":2438.2998918680228,"y":2491.0432881708552,"rotation":0.24434609527920603,"isLocked":false,"opacity"